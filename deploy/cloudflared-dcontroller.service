[Unit]
Description=Cloudflare Tunnel connector for dcontroller
Documentation=https://github.com/zbynekdrlik/dcontroller
Wants=network-online.target
After=network-online.target dcontroller.service

[Service]
Type=simple
# The connector token (root 0600, never in git) is handed in as a systemd
# credential, so the connector runs as an unprivileged dynamic user.
LoadCredential=token:/etc/cloudflared-dcontroller/token
ExecStart=/usr/bin/cloudflared --no-autoupdate --protocol http2 tunnel run --token-file ${CREDENTIALS_DIRECTORY}/token
Restart=on-failure
RestartSec=5
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=yes

[Install]
WantedBy=multi-user.target
