[Unit]
Description=dcontroller web Dante controller
Documentation=https://github.com/zbynekdrlik/dcontroller
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=dcontroller
Group=dcontroller
ExecStart=/opt/dcontroller/dcontroller /etc/dcontroller/config.toml
Restart=on-failure
RestartSec=2
Environment=RUST_LOG=info,tower_http=info
# Control traffic only (mDNS, ARC); no audio, no realtime priority.
Nice=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
